# Frontend environment variables
# ------------------------------

# Set this during local development to your backend URL.
# In production, Vite embeds the build-time value or falls back to
# https://vibesta.onrender.com (see src/lib/api.js).
VITE_API_BASE_URL=http://localhost:8000

# Socket.IO server URL. Defaults to VITE_API_BASE_URL.
VITE_SOCKET_URL=http://localhost:8000
