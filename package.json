{
  "name": "vibesta",
  "version": "1.0.0",
  "private": true,
  "packageManager": "npm@10.9.4",
  "type": "module",
  "description": "Vibesta monorepo powered by Turborepo",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "start": "turbo start --filter=@vibesta/backend",
    "lint": "turbo lint",
    "clean": "turbo clean"
  },
  "devDependencies": {
    "turbo": "^2.10.11"
  }
}
