{
  "name": "vibesta",
  "version": "1.0.0",
  "private": true,
  "packageManager": "npm@10.9.4",
  "type": "module",
  "description": "Vibesta monorepo powered by Turborepo",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "start": "turbo start --filter=@vibesta/backend",
    "lint": "turbo lint",
    "format": "prettier --write \"apps/**/*.{js,jsx,ts,tsx,json,css,md}\"",
    "format:check": "prettier --check \"apps/**/*.{js,jsx,ts,tsx,json,css,md}\"",
    "clean": "turbo clean"
  },
  "devDependencies": {
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "prettier": "^3.9.6",
    "turbo": "^2.10.11"
  }
}
